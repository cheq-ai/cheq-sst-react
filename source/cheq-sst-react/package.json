{
    "name": "@cheq.ai/cheq-sst-react",
    "version": "0.1.1",
    "description": "CHEQ Server-Side Tagging SDK for React and React Native applications",
    "author": "CHEQ AI Technologies <tms+npm@cheq.ai>",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cheq-ai/cheq-sst-react.git"
    },
    "bugs": {
        "url": "https://github.com/cheq-ai/cheq-sst-react/issues"
    },
    "homepage": "https://github.com/cheq-ai/cheq-sst-react#readme",
    "keywords": [
        "cheq",
        "sst",
        "server-side-tagging",
        "react",
        "react-native",
        "analytics",
        "tag-management"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.js",
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": true,
    "scripts": {
        "build": "tsup && cp ../../README.md ./README.md",
        "dev": "tsup --watch",
        "prepare": "npm run build"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./dist/index.native.js",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "peerDependencies": {
        "react": ">=17"
    },
    "devDependencies": {
        "@types/node": "^25.0.10",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "optionalDependencies": {
        "expo-tracking-transparency": "^6.0.8",
        "react-native-device-info": "^15.0.1",
        "react-native-localize": "^3.6.1"
    }
}
