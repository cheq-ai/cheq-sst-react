{
    "name": "@cheq.ai/cheq-sst-react",
    "version": "0.1.3",
    "description": "CHEQ Server-Side Tagging SDK for React and React Native applications",
    "author": "CHEQ AI Technologies <tms+npm@cheq.ai>",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cheq-ai/cheq-sst-react.git"
    },
    "bugs": {
        "url": "https://github.com/cheq-ai/cheq-sst-react/issues"
    },
    "homepage": "https://github.com/cheq-ai/cheq-sst-react#readme",
    "keywords": [
        "cheq",
        "sst",
        "server-side-tagging",
        "react",
        "react-native",
        "analytics",
        "tag-management"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./dist/index.native.js",
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": true,
    "scripts": {
        "build": "tsup && cp ../../README.md ./README.md",
        "dev": "tsup --watch",
        "prepare": "npm run build",
        "typecheck": "tsc --noEmit",
        "pretest": "npm run typecheck && npm run build",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "react-native": "./dist/index.native.js",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "peerDependencies": {
        "@react-native-async-storage/async-storage": ">=1",
        "expo-localization": "*",
        "expo-tracking-transparency": "*",
        "react": ">=17",
        "react-native-device-info": "*",
        "react-native-localize": "*",
        "react-native-tracking-transparency": "*"
    },
    "devDependencies": {
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@types/node": "^25.0.10",
        "expo-localization": "*",
        "expo-tracking-transparency": "*",
        "react-native-device-info": "^15.0.1",
        "react-native-localize": "^3.6.1",
        "react-native-tracking-transparency": "^0.1.2",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "peerDependenciesMeta": {
        "@react-native-async-storage/async-storage": {
            "optional": true
        },
        "expo-localization": {
            "optional": true
        },
        "expo-tracking-transparency": {
            "optional": true
        },
        "react-native-device-info": {
            "optional": true
        },
        "react-native-localize": {
            "optional": true
        },
        "react-native-tracking-transparency": {
            "optional": true
        }
    }
}
